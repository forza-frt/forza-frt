{
  "name": "radar-map",
  "version": "1.0.0",
  "description": "Radar Map — PWA: speed cameras and speed limits on a map",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forza-frt/forza-frt.git"
  },
  "bugs": {
    "url": "https://github.com/forza-frt/forza-frt/issues"
  },
  "homepage": "https://github.com/forza-frt/forza-frt#readme",
  "dependencies": {
    "express": "^4.22.3",
    "leaflet": "1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
