# ---- Server (server/index.ts) — secrets stay here, never in frontend code ----
PORT=8787

# kartes.lv speed-camera API (optional; Latvia).
# Get a key: https://developers.kartes.lv/ (register / contact Jāņa sēta, see "API key" on the site).
KARTES_API_KEY=

# Request URL exactly as given in https://developers.kartes.lv/en/speedcameras/
# Placeholders: {key} {south} {west} {north} {east}. Example shape (CHECK AGAINST THE DOCS):
#   KARTES_SPEEDCAMERAS_URL=https://<host from docs>/<path>?key={key}&bbox={west},{south},{east},{north}
KARTES_SPEEDCAMERAS_URL=

# Origins allowed to call /api when the frontend is hosted elsewhere, e.g. https://user.github.io
CORS_ORIGINS=

# How long the server caches kartes.lv answers.
KARTES_CACHE_MINUTES=60

# ---- Frontend (public, baked into the build — NO secrets here) ----
# Where the server above runs, if the frontend is hosted elsewhere (e.g. GitHub Pages). Empty = same origin.
VITE_API_BASE=
# Comma-separated Overpass API endpoints (optional override).
VITE_OVERPASS_URLS=
